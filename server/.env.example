# Copia este archivo como .env y cambia los valores
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=farmacia

# Clave para firmar los tokens (escribe una frase larga y secreta)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
JWT_EXPIRA=8h

# Contraseñas de los usuarios de prueba (se usan con: npm run crear-usuarios)
ADMIN_PASSWORD=Admin123
BASICO_PASSWORD=Basico123
